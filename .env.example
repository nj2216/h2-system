# Environment Configuration for H2 System
# Copy this file to .env and update the values

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production

# Database
DATABASE_URL=sqlite:///h2_system.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://username:password@localhost:5432/h2_system

# Connection Pool (used for PostgreSQL/MySQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# SQLite only (development)
SQLITE_TIMEOUT=30

# Server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
